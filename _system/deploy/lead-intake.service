[Unit]
Description=My Villa lead intake (Gmail Formspree notifications -> ledger -> ack + alert), one run
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/myvilla
EnvironmentFile=/opt/myvilla/.env
Environment=MYVILLA_PRIVATE_DIR=/opt/myvilla-private
Environment=PYTHONUNBUFFERED=1
# Claude via ABBONAMENTO (policy 2026-09-16): nessuna ANTHROPIC_API_KEY.
# Il servizio usa llm_client.py -> Claude Code CLI headless, autenticata con
# CLAUDE_CODE_OAUTH_TOKEN letto da /opt/myvilla/.env (EnvironmentFile).
# IS_SANDBOX=1: il servizio gira come root e la CLI rifiuta la modalita'
# bypassPermissions (usata solo per web_search=True) da root senza questo flag.
Environment=IS_SANDBOX=1
ExecStart=/usr/bin/python3 /opt/myvilla/_system/scripts/lead_intake.py --max 25
User=root
UMask=0077
